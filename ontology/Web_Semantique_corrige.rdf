<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/romdh/ontologies/2026/8/untitled-ontology-2/"
     xml:base="http://www.semanticweb.org/romdh/ontologies/2026/8/untitled-ontology-2/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:smartgrid-ontology="http://www.semanticweb.org/smartgrid-ontology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/smartgrid-ontology"/>

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    <!-- ===== Object properties ===== -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#produitEnergie">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#estAlimentePar">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#produitEnergie"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#stockeEnergie">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#UniteStockage"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#estConnecteA">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#transporteVers">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#possedeCompteur">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#gerePar">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#GestionnaireReseau"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#utiliseOnduleur">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Onduleur"/>
    </owl:ObjectProperty>

    <!-- ===== Data properties ===== -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#capaciteProduction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#capaciteStockage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#UniteStockage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#consommationAnnuelle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#longueurLigne">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#nomBatiment">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#rendement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/smartgrid-ontology#tensionLigne">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- ===== Classes ===== -->
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smartgrid-ontology#possedeCompteur"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#Industriel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Residentiel"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Tertiaire"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#Residentiel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Tertiaire"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#Tertiaire">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#Compteur"/>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#GestionnaireReseau"/>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#GrosConsommateur">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/smartgrid-ontology#BatimentConsommateur"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/smartgrid-ontology#consommationAnnuelle"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10000.0</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#LigneTransport">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smartgrid-ontology#gerePar"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/smartgrid-ontology#GestionnaireReseau"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#HauteTension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/smartgrid-ontology#MoyenneTension"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#MoyenneTension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#Onduleur"/>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smartgrid-ontology#estConnecteA"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneTransport"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/smartgrid-ontology#UniteStockage"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#SourceRenouvelable">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#Eolienne">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceRenouvelable"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/smartgrid-ontology#PanneauSolaire"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#PanneauSolaire">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceRenouvelable"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#SourceGrandeCapacite">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/smartgrid-ontology#capaciteProduction"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">500.0</xsd:minExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#UniteStockage">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/smartgrid-ontology#stockeEnergie"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/smartgrid-ontology#SourceEnergie"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#Batterie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#UniteStockage"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/smartgrid-ontology#StationPompage"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/smartgrid-ontology#StationPompage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/smartgrid-ontology#UniteStockage"/>
    </owl:Class>

    <!-- ===== Individuals ===== -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#PanneauSolaire_ESPRIT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#PanneauSolaire"/>
        <smartgrid-ontology:capaciteProduction rdf:datatype="http://www.w3.org/2001/XMLSchema#float">50.0</smartgrid-ontology:capaciteProduction>
        <smartgrid-ontology:rendement rdf:datatype="http://www.w3.org/2001/XMLSchema#float">18.5</smartgrid-ontology:rendement>
        <smartgrid-ontology:produitEnergie rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentESPRIT"/>
        <smartgrid-ontology:estConnecteA rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneMT_Ariana1"/>
        <smartgrid-ontology:utiliseOnduleur rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Onduleur_SMA1"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#Eolienne_Bizerte1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Eolienne"/>
        <smartgrid-ontology:capaciteProduction rdf:datatype="http://www.w3.org/2001/XMLSchema#float">300.0</smartgrid-ontology:capaciteProduction>
        <smartgrid-ontology:produitEnergie rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentResidentiel1"/>
        <smartgrid-ontology:estConnecteA rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneHT_Tunis_Sfax"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#Eolienne_Sfax1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Eolienne"/>
        <smartgrid-ontology:capaciteProduction rdf:datatype="http://www.w3.org/2001/XMLSchema#float">600.0</smartgrid-ontology:capaciteProduction>
        <smartgrid-ontology:rendement rdf:datatype="http://www.w3.org/2001/XMLSchema#float">35.0</smartgrid-ontology:rendement>
        <smartgrid-ontology:produitEnergie rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentIndustriel1"/>
        <smartgrid-ontology:estConnecteA rdf:resource="http://www.semanticweb.org/smartgrid-ontology#LigneHT_Tunis_Sfax"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#Batterie_Lithium1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Batterie"/>
        <smartgrid-ontology:capaciteStockage rdf:datatype="http://www.w3.org/2001/XMLSchema#float">100.0</smartgrid-ontology:capaciteStockage>
        <smartgrid-ontology:stockeEnergie rdf:resource="http://www.semanticweb.org/smartgrid-ontology#PanneauSolaire_ESPRIT1"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#StationPompage_Zaghouan1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#StationPompage"/>
        <smartgrid-ontology:capaciteStockage rdf:datatype="http://www.w3.org/2001/XMLSchema#float">5000.0</smartgrid-ontology:capaciteStockage>
        <smartgrid-ontology:stockeEnergie rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Eolienne_Bizerte1"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#BatimentESPRIT">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Tertiaire"/>
        <smartgrid-ontology:consommationAnnuelle rdf:datatype="http://www.w3.org/2001/XMLSchema#float">8000.0</smartgrid-ontology:consommationAnnuelle>
        <smartgrid-ontology:nomBatiment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Campus ESPRIT</smartgrid-ontology:nomBatiment>
        <smartgrid-ontology:possedeCompteur rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur_ESPRIT1"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#BatimentResidentiel1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Residentiel"/>
        <smartgrid-ontology:consommationAnnuelle rdf:datatype="http://www.w3.org/2001/XMLSchema#float">4500.0</smartgrid-ontology:consommationAnnuelle>
        <smartgrid-ontology:nomBatiment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Résidence El Manar</smartgrid-ontology:nomBatiment>
        <smartgrid-ontology:possedeCompteur rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur_Residentiel1"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#BatimentIndustriel1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Industriel"/>
        <smartgrid-ontology:consommationAnnuelle rdf:datatype="http://www.w3.org/2001/XMLSchema#float">25000.0</smartgrid-ontology:consommationAnnuelle>
        <smartgrid-ontology:nomBatiment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Usine Sfax</smartgrid-ontology:nomBatiment>
        <smartgrid-ontology:possedeCompteur rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur_Industriel1"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#LigneHT_Tunis_Sfax">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#HauteTension"/>
        <smartgrid-ontology:tensionLigne rdf:datatype="http://www.w3.org/2001/XMLSchema#float">225.0</smartgrid-ontology:tensionLigne>
        <smartgrid-ontology:longueurLigne rdf:datatype="http://www.w3.org/2001/XMLSchema#float">270.0</smartgrid-ontology:longueurLigne>
        <smartgrid-ontology:transporteVers rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentIndustriel1"/>
        <smartgrid-ontology:transporteVers rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentResidentiel1"/>
        <smartgrid-ontology:gerePar rdf:resource="http://www.semanticweb.org/smartgrid-ontology#GestionnaireReseau_STEG"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#LigneMT_Ariana1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#MoyenneTension"/>
        <smartgrid-ontology:tensionLigne rdf:datatype="http://www.w3.org/2001/XMLSchema#float">30.0</smartgrid-ontology:tensionLigne>
        <smartgrid-ontology:longueurLigne rdf:datatype="http://www.w3.org/2001/XMLSchema#float">15.0</smartgrid-ontology:longueurLigne>
        <smartgrid-ontology:transporteVers rdf:resource="http://www.semanticweb.org/smartgrid-ontology#BatimentESPRIT"/>
        <smartgrid-ontology:gerePar rdf:resource="http://www.semanticweb.org/smartgrid-ontology#GestionnaireReseau_STEG"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#Compteur_ESPRIT1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#Compteur_Residentiel1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#Compteur_Industriel1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Compteur"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#Onduleur_SMA1">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#Onduleur"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/smartgrid-ontology#GestionnaireReseau_STEG">
        <rdf:type rdf:resource="http://www.semanticweb.org/smartgrid-ontology#GestionnaireReseau"/>
    </owl:NamedIndividual>
</rdf:RDF>
